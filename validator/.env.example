# KubeTEE subnet-owner validator configuration.
# Copy to validator/.env (gitignored) and fill in. The validator fails fast on
# any missing/invalid required variable. Secrets are injected as Kubernetes
# Secrets in production (never committed).

# --- Chain (Finney from day one) ---
# SN90 netuid.
SUBNET_NETUID=90
# Chain network name; default finney. Override SUBTENSOR_ENDPOINT to debug.
BT_NETWORK=finney
# Optional explicit subtensor websocket endpoint (overrides BT_NETWORK).
# SUBTENSOR_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443

# --- Validator hotkey (seed only, from a secret; no coldkey, no keyfiles) ---
# The sr25519 mnemonic that derives the validator hotkey used to sign set_weights.
VALIDATOR_HOTKEY_SEED=

# Owner (subnet-owner) UID whose weights receive the unallocated remainder.
KUBETEE_OWNER_UID=0

# --- Rancher v3 (read-only cluster/node evidence) ---
RANCHER_URL=https://rancher.example.com
RANCHER_BEARER_TOKEN=
# Optional CA bundle for the Rancher HTTP client only (not chain TLS).
# RANCHER_CA_FILE=/etc/ssl/rancher-ca.pem

# --- Scoring window ---
# Seconds between cycles (one epoch) and hours over which tenure accrues.
KUBETEE_CYCLE_SECONDS=360
KUBETEE_WINDOW_HOURS=1.0

# --- Compensation pricing (Taostats) — HARD dependency ---
# A failure here skips the cycle and previous on-chain weights persist.
TAOSTATS_API_KEY=

# --- GPU price card ($/GPU/hour) overrides, as JSON, e.g. {"H100":3.0} ---
# KUBETEE_GPU_USD_PRICES={"H100":3.0,"H200":3.5,"B200":6.5,"B300":8.0}

# Total USD the epoch allocates per hour (the emission budget). Whatever the
# miners do NOT earn of this recycles to the owner UID. 0 = miners split the
# whole pot (owner remainder 0).
KUBETEE_EMISSION_USD_PER_HOUR=0

# --- Competitive pricing (Targon supply-side clamp) — FAIL-SOFT ---
# Optional; only for the subnet-owner's validator. Set to "true" to activate
# the Targon supply-side clamp (pulls the GPU card DOWN toward SN4 payouts).
# Default off; readers (non-owner validators) leave this off.
KUBETEE_TARGON_PAYOUT_ENABLED=false
# Floor as a fraction of the card price (default 0.75).
KUBETEE_TARGON_PRICE_FLOOR_FRAC=0.75

# --- Hippius S3 publish (subnet-owner / publisher ONLY) ---
# Presence of the secret key selects the publisher role; readers omit both.
# Always published with a signed `x-amz-acl: public-read` header.
# KUBETEE_HIPPIUS_ACCESS_KEY=
# KUBETEE_HIPPIUS_SECRET_KEY=

# --- Metrics ---
KUBETEE_METRICS_PORT=9100
