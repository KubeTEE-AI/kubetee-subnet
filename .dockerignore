# Docker build context is the repo root (docker build -f validator/Dockerfile .)
# This file MUST sit at the context root — validator/.dockerignore is ineffective
# for the documented build and is kept only as a no-op.
.git
.github
.gitmodules
.gitignore
# The chain source reference is not needed at image build time -- the SDK is
# installed from the official PyPI release (see validator/Dockerfile). Dropping
# it here keeps the build context to just validator/ + this repo's own files.
subtensor/
kubetee_subnet.egg-info/
.pytest_cache
docs/
README.md
CLAUDE.md
.markdownlint.json
LICENSE
SECURITY.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
pyproject.toml
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!validator/.env.example
