# Docker build context is the repo root (docker build -f validator/Dockerfile .)
# This file MUST sit at the context root — validator/.dockerignore is ineffective
# for the documented build and is kept only as a no-op.
.git
.github
.gitmodules
.gitignore
subtensor/.git
subtensor/.gitmodules
# Cargo/maturin artifacts and non-code subtensor trees. The build needs the
# subtensor CARGO WORKSPACE intact (root Cargo.toml + Cargo.lock +
# rust-toolchain.toml + every member and every `[patch]` target under vendor/)
# because `sdk/bittensor-core-py` is a workspace member -- its `sp-core` and
# `w3f-bls` deps resolve through the root manifest. Only non-code paths may be
# dropped here; trimming any listed member or vendor/ target breaks resolution.
subtensor/target/
subtensor/docs/
subtensor/website/
subtensor/ts-tests/
subtensor/.github/
subtensor/.claude/
subtensor/.agents/
subtensor/.openai/
subtensor/.vscode/
subtensor/.maintain/
kubetee_subnet.egg-info/
.pytest_cache
docs/
README.md
CLAUDE.md
.markdownlint.json
LICENSE
SECURITY.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
pyproject.toml
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!validator/.env.example
